# Vercel > Project > Settings > Environment Variables 에 같은 이름으로 넣는다. (이 파일에는 실제 값을 쓰지 말 것)
DASHBOARD_PASSWORD=          # 접속 비밀번호. 비어 있으면 운영(production)에서는 모든 접속을 막는다.
SUPABASE_URL=                # https://<프로젝트>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # 서버 전용 키. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.

# ── 2단계: 투자 대가 판단 (NVIDIA NIM) ─────────────────────────────
NVIDIA_API_KEY=              # build.nvidia.com 키. 여러 개면 NVIDIA_API_KEY_2, _3 … (밑줄 필수)
NVIDIA_MODEL=                # 비우면 minimaxai/minimax-m3.1-flash. 호출이 안 되면(단종·미배포) 다른 모델 이름으로
AI_DAILY_CAP=300             # 하루 AI 호출 상한 (기본 300). 매일 자동분만 약 170회: 종목 판단 4회×20 + 산업 토론 9회×10
